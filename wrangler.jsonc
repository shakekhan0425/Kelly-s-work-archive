{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kelly-work-archive",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://xecllrzcdalpxbxekunm.supabase.co"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
