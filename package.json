{
  "name": "work-archive-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "CF_WORKERS_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "CF_WORKERS_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "pipeline": "tsx pipeline/cli.ts",
    "pipeline:seed": "tsx pipeline/seed.ts",
    "pipeline:ingest": "tsx pipeline/cli.ts ingest --all",
    "pipeline:export": "tsx pipeline/export-to-archive.ts",
    "pipeline:cron": "tsx pipeline/cli.ts cron",
    "migrate:supabase": "tsx scripts/migrate-to-supabase.ts",
    "ingest:web": "tsx pipeline/ingest-web.ts",
    "ingest:sites": "tsx pipeline/ingest-sites.ts",
    "ingest:cases": "tsx pipeline/ingest-cases.ts",
    "ingest:podcasts": "tsx pipeline/fetch-podcasts.ts",
    "ingest:english": "tsx pipeline/ingest-english.ts",
    "mark:live": "tsx pipeline/mark-live.ts"
  },
  "dependencies": {
    "@extractus/article-extractor": "^7.3.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "openai": "^4.77.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
